{
  "project_context": {
    "app_name": "PropStack",
    "app_type": "SaaS Dashboard",
    "industry": "Property & Hospitality Management",
    "target_audience": "Property managers, investors, hospitality owners",
    "design_persona": "E1 (Premium, Minimalist, Function-First)"
  },
  "design_system": {
    "theme_strategy": {
      "mode": "light",
      "background_style": "flat_minimal",
      "visual_density": "high_comfort"
    },
    "colors": {
      "palette": {
        "primary": {
          "DEFAULT": "#0D9488",
          "hover": "#0F766E",
          "foreground": "#FFFFFF",
          "light": "#CCFBF1",
          "description": "Teal 600 - Used ONLY for primary actions, active states, and positive metrics"
        },
        "background": {
          "DEFAULT": "#F9FAFB",
          "paper": "#FFFFFF",
          "subtle": "#F3F4F6"
        },
        "text": {
          "primary": "#111827",
          "secondary": "#4B5563",
          "tertiary": "#9CA3AF",
          "on_primary": "#FFFFFF"
        },
        "border": {
          "DEFAULT": "#E5E7EB",
          "focus": "#0D9488"
        },
        "status": {
          "success": "#0D9488",
          "error": "#EF4444",
          "warning": "#F59E0B",
          "info": "#3B82F6"
        }
      },
      "tailwind_config_extension": {
        "colors": {
          "border": "hsl(220 13% 91%)",
          "input": "hsl(220 13% 91%)",
          "ring": "hsl(175 84% 32%)",
          "background": "hsl(210 20% 98%)",
          "foreground": "hsl(220 13% 10%)",
          "primary": {
            "DEFAULT": "hsl(175 84% 32%)",
            "foreground": "hsl(0 0% 100%)"
          },
          "secondary": {
            "DEFAULT": "hsl(210 20% 96%)",
            "foreground": "hsl(220 13% 9%)"
          },
          "destructive": {
            "DEFAULT": "hsl(0 84% 60%)",
            "foreground": "hsl(0 0% 100%)"
          },
          "muted": {
            "DEFAULT": "hsl(210 20% 96%)",
            "foreground": "hsl(220 9% 46%)"
          },
          "accent": {
            "DEFAULT": "hsl(175 84% 95%)",
            "foreground": "hsl(175 84% 32%)"
          },
          "popover": {
            "DEFAULT": "hsl(0 0% 100%)",
            "foreground": "hsl(220 13% 10%)"
          },
          "card": {
            "DEFAULT": "hsl(0 0% 100%)",
            "foreground": "hsl(220 13% 10%)"
          }
        }
      }
    },
    "typography": {
      "font_family": {
        "heading": "Manrope, sans-serif",
        "body": "Public Sans, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "scale": {
        "h1": "text-4xl font-bold tracking-tight text-gray-900",
        "h2": "text-3xl font-bold tracking-tight text-gray-900",
        "h3": "text-2xl font-semibold tracking-tight text-gray-900",
        "h4": "text-xl font-semibold tracking-tight text-gray-900",
        "body_lg": "text-lg font-normal leading-relaxed text-gray-700",
        "body_base": "text-base font-normal leading-relaxed text-gray-600",
        "caption": "text-sm font-medium text-gray-500",
        "label": "text-xs font-semibold uppercase tracking-wider text-gray-500"
      },
      "rules": "No 'Inter' for headings. Use tight tracking for headings (-0.02em). Numbers/Data should use tabular-nums where possible."
    },
    "spacing_and_layout": {
      "base_unit": "4px",
      "rhythm": "8px/12px",
      "radius": {
        "card": "12px (rounded-xl)",
        "button": "8px (rounded-lg)",
        "input": "8px (rounded-lg)"
      },
      "shadows": {
        "card": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
        "card_hover": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)",
        "dropdown": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)"
      },
      "grid_strategy": "Bento Grid Mode B (High Density)",
      "container_padding": "p-6 md:p-8 lg:p-12"
    }
  },
  "component_guidelines": {
    "cards": {
      "style": "bg-white border border-gray-100 shadow-sm rounded-xl",
      "hover": "hover:shadow-md hover:border-gray-200 transition-all duration-200",
      "content_padding": "p-6"
    },
    "buttons": {
      "primary": "bg-teal-600 hover:bg-teal-700 text-white shadow-sm font-medium rounded-lg px-4 py-2 transition-colors",
      "secondary": "bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 shadow-sm font-medium rounded-lg px-4 py-2 transition-colors",
      "ghost": "hover:bg-gray-100 text-gray-600 hover:text-gray-900 rounded-lg px-4 py-2 transition-colors",
      "destructive": "bg-white hover:bg-red-50 text-red-600 border border-red-200 shadow-sm font-medium rounded-lg px-4 py-2"
    },
    "inputs": {
      "style": "h-10 rounded-lg border-gray-200 focus:border-teal-500 focus:ring-teal-500/20 bg-white shadow-sm",
      "labels": "text-sm font-medium text-gray-700 mb-1.5 block"
    },
    "tables": {
      "wrapper": "rounded-xl border border-gray-200 overflow-hidden bg-white shadow-sm",
      "header": "bg-gray-50/50 border-b border-gray-200 text-xs font-semibold uppercase text-gray-500 tracking-wider",
      "row": "hover:bg-gray-50/50 transition-colors border-b border-gray-100 last:border-0",
      "cell": "py-3 px-4 text-sm text-gray-600"
    },
    "navigation": {
      "sidebar": "bg-white border-r border-gray-200 w-64 fixed h-full z-30",
      "sidebar_item": "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors",
      "sidebar_item_active": "bg-teal-50 text-teal-700 hover:bg-teal-50 hover:text-teal-800"
    },
    "charts": {
      "palette": ["#0D9488", "#14B8A6", "#5EEAD4", "#99F6E4", "#CCFBF1"],
      "style": "Clean, minimal grid lines, tooltips with shadow-lg"
    },
    "modals": {
      "overlay": "bg-gray-900/40 backdrop-blur-sm",
      "content": "bg-white rounded-xl shadow-2xl border border-gray-100 p-6 max-w-lg w-full animate-in fade-in zoom-in-95 duration-200"
    }
  },
