  "universal_guidelines": [
    "DO NOT use transparent backgrounds for overlays, dropdowns, or headers if content scrolls behind. Use solid backgrounds or high-blur glassmorphism (bg-white/90 backdrop-blur-md).",
    "Every interactive element (button, input, link) MUST have a `data-testid` attribute in kebab-case (e.g., `data-testid='submit-login'`).",
    "Use `rounded-xl` for all major containers (Cards, Modals) and `rounded-lg` for inner elements (Buttons, Inputs).",
    "Spacing should be generous. Use `gap-6` or `gap-8` for grid layouts.",
    "Typography: Use `Manrope` for Headings/Numbers and `Public Sans` for Body. If Public Sans is not available, fall back to system fonts, but ensure Manrope is imported.",
    "Never use pure black (#000000). Use #111827 or #0F172A.",
    "Animations: Use subtle `duration-200 ease-in-out` for hover states. No jarring movements.",
    "File Extension: Use `.js` or `.jsx` for React components. Do not use `.tsx`."
  ],
  "instructions_to_main_agent": {
    "step_1": "Update `tailwind.config.js` and `index.css` with the provided Teal color palette and font families.",
    "step_2": "Ensure `Manrope` and `Public Sans` fonts are imported in `index.css`.",
    "step_3": "Refactor the Sidebar to be Light Mode with Teal active states.",
    "step_4": "Update the Dashboard layout to use a 'Bento Grid' (Mode B) structure.",
    "step_5": "Apply premium card styling (white bg, subtle border, shadow-sm) to all data containers.",
    "step_6": "Verify all interactive elements have `data-testid`."
  }
}